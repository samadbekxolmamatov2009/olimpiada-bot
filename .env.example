BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Majburiy obuna kanali. Botni shu kanalga ADMIN qilib qo'shing (aks holda
# obunani tekshira olmaydi). Raqamli ID (-100...) yoki @username bo'lishi mumkin.
CHANNEL_ID=-1001234567890
# Ixtiyoriy: "Kanalga o'tish" tugmasi havolasi. CHANNEL_ID @username bo'lsa,
# avtomatik hosil qilinadi; raqamli (yopiq) kanal uchun bu yerga taklif havolasini yozing.
CHANNEL_URL=https://t.me/your_channel

# Render'da bu avtomatik (RENDER_EXTERNAL_URL) to'ldiriladi — qo'lda yozish shart emas.
# Boshqa hostda ishlatsangiz, bot joylashgan ochiq https manzilni shu yerga yozing.
PUBLIC_URL=

# Ixtiyoriy: webhook manzilini taxmin qilib bo'lmasligi uchun o'z maxfiy so'zingizni yozing.
WEBHOOK_SECRET=
